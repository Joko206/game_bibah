      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ManajerPermainan</string>
          <string name="Source"><![CDATA[local DataSurah = require(game.ReplicatedStorage.Shared.SurahData)

-- Module ini bertugas mengolah data surah dan verifikasi jawaban
-- Sengaja dipisah agar GameServer lebih fokus mengatur alur game
local ManajerPermainan = {}

-- Helper untuk menghapus tanda baca atau normalisasi teks jika dibutuhkan
local function normalisasiTeks(teks)
    -- Saat ini masih sederhana. Bila ayat ada harakat, bisa di-strip disini.
    return string.lower(teks:match("^%s*(.-)%s*$"))
end

function ManajerPermainan.ambilAyatAcak()
    local indeksSurah = math.random(1, #DataSurah)
    local surah = DataSurah[indeksSurah]
    local indeksAyat = math.random(1, #surah.ayat - 1)
    
    return surah.ayat[indeksAyat], surah.ayat[indeksAyat + 1], surah.name
end

function ManajerPermainan.cekJawaban(masukanPemain, jawabanSeharusnya)
    local nInput = normalisasiTeks(masukanPemain)
    local nTarget = normalisasiTeks(jawabanSeharusnya)
    
    return nInput == nTarget
end

return ManajerPermainan
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">PembuatArena</string>
          <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")

local PembuatArena = {}

-- ==========================================
-- 3D MAP GENERATOR (Membuat Arena & Pintu)
-- ==========================================
function PembuatArena.buatArena(idRuangan)
    local posisiAwal = Vector3.new(0, 50, idRuangan * 500)
    
    local modelArena = Instance.new("Model")
    modelArena.Name = "Arena_" .. idRuangan
    modelArena.Parent = Workspace
    
    -- Pencahayaan
    local cahayaSekitar = Instance.new("PointLight")
    cahayaSekitar.Range = 60
    cahayaSekitar.Brightness = 1.2
    cahayaSekitar.Color = Color3.fromRGB(142, 162, 128)
    
    -- Particle Effect (Debu Kosmik)
    local debu = Instance.new("ParticleEmitter")
    debu.Color = ColorSequence.new(Color3.fromRGB(255, 230, 150))
    debu.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.4), NumberSequenceKeypoint.new(1, 0)})
    debu.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.5), NumberSequenceKeypoint.new(1, 1)})
    debu.Lifetime = NumberRange.new(2, 5)
    debu.Rate = 50
    debu.Speed = NumberRange.new(1, 3)
    debu.SpreadAngle = Vector2.new(180, 180)
    
    -- Spectator Platform (Ruang Tunggu)
    local panggungPenonton = Instance.new("Part")
    panggungPenonton.Name = "PanggungPenonton"
    panggungPenonton.Size = Vector3.new(40, 2, 20)
    panggungPenonton.Position = posisiAwal + Vector3.new(0, 0, -50)
    panggungPenonton.Anchored = true
    panggungPenonton.Material = Enum.Material.Glass
    panggungPenonton.BrickColor = BrickColor.new("Navy blue")
    panggungPenonton.Parent = modelArena
    
    local d1 = debu:Clone()
    d1.Parent = panggungPenonton
    
    local cahayaPenonton = Instance.new("Part")
    cahayaPenonton.Size = Vector3.new(42, 1, 22)
    cahayaPenonton.Position = panggungPenonton.Position - Vector3.new(0, 0.5, 0)
    cahayaPenonton.Anchored = true
    cahayaPenonton.Material = Enum.Material.SmoothPlastic
    cahayaPenonton.BrickColor = BrickColor.new("Olive")
    cahayaPenonton.Parent = modelArena
    
    local l1 = cahayaSekitar:Clone()
    l1.Parent = panggungPenonton

    -- Tembok Pelindung Spectator
    local function buatTembok(ukuran, posisi)
        local t = Instance.new("Part")
        t.Size = ukuran
        t.Position = posisi
        t.Anchored = true
        t.Material = Enum.Material.Glass
        t.Color = Color3.fromRGB(70, 92, 83)
        t.Transparency = 0.35
        t.Parent = modelArena
    end
    
    local tinggiTembok = 15
    buatTembok(Vector3.new(1, tinggiTembok, 20), panggungPenonton.Position + Vector3.new(-20, tinggiTembok/2, 0)) -- Kiri
    buatTembok(Vector3.new(1, tinggiTembok, 20), panggungPenonton.Position + Vector3.new(20, tinggiTembok/2, 0))  -- Kanan
    buatTembok(Vector3.new(40, tinggiTembok, 1), panggungPenonton.Position + Vector3.new(0, tinggiTembok/2, -10)) -- Belakang
    buatTembok(Vector3.new(40, tinggiTembok, 1), panggungPenonton.Position + Vector3.new(0, tinggiTembok/2, 10))  -- Depan

    -- Start Platform (Arena Utama)
    local panggungMulai = Instance.new("Part")
    panggungMulai.Name = "PanggungMulai"
    panggungMulai.Size = Vector3.new(40, 2, 20)
    panggungMulai.Position = posisiAwal + Vector3.new(0, 0, 0)
    panggungMulai.Anchored = true
    panggungMulai.Material = Enum.Material.SmoothPlastic
    panggungMulai.BrickColor = BrickColor.new("Dark stone grey")
    panggungMulai.Parent = modelArena
    
    local d2 = debu:Clone()
    d2.Parent = panggungMulai
    
    local cahayaMulai = Instance.new("Part")
    cahayaMulai.Size = Vector3.new(42, 1, 22)
    cahayaMulai.Position = panggungMulai.Position - Vector3.new(0, 0.5, 0)
    cahayaMulai.Anchored = true
    cahayaMulai.Material = Enum.Material.SmoothPlastic
    cahayaMulai.BrickColor = BrickColor.new("Brown")
    cahayaMulai.Parent = modelArena
    
    local l2 = cahayaSekitar:Clone()
    l2.Brightness = 0.9
    l2.Color = Color3.fromRGB(168, 142, 88)
    l2.Parent = panggungMulai
    
    -- SUCCESS PLATFORM (Zona Aman di Belakang Pintu)
    local panggungBerhasil = Instance.new("Part")
    panggungBerhasil.Name = "PanggungBerhasil"
    panggungBerhasil.Size = Vector3.new(40, 2, 20)
    panggungBerhasil.Position = posisiAwal + Vector3.new(0, 0, 21)
    panggungBerhasil.Anchored = true
    panggungBerhasil.Material = Enum.Material.SmoothPlastic
    panggungBerhasil.BrickColor = BrickColor.new("Dark stone grey")
    panggungBerhasil.Parent = modelArena
    
    local cahayaBerhasil = Instance.new("Part")
    cahayaBerhasil.Size = Vector3.new(42, 1, 22)
    cahayaBerhasil.Position = panggungBerhasil.Position - Vector3.new(0, 0.5, 0)
    cahayaBerhasil.Anchored = true
    cahayaBerhasil.Material = Enum.Material.SmoothPlastic
    cahayaBerhasil.BrickColor = BrickColor.new("Sea green")
    cahayaBerhasil.Parent = modelArena
    
    local l3 = cahayaSekitar:Clone()
    l3.Brightness = 1
    l3.Color = Color3.fromRGB(132, 184, 132)
    l3.Parent = panggungBerhasil

    -- Void pit di bawah arena untuk reset pemain yang jatuh
    local jurangMaut = Instance.new("Part")
    jurangMaut.Name = "JurangMaut"
    jurangMaut.Size = Vector3.new(300, 10, 300)
    jurangMaut.Position = posisiAwal + Vector3.new(0, -150, 0)
    jurangMaut.Anchored = true
    jurangMaut.Material = Enum.Material.Slate
    jurangMaut.Color = Color3.fromRGB(50, 36, 34)
    jurangMaut.Parent = modelArena
    
    local api = Instance.new("ParticleEmitter")
    api.Color = ColorSequence.new(Color3.fromRGB(148, 80, 52), Color3.fromRGB(102, 56, 40))
    api.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 7)})
    api.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1)})
    api.Lifetime = NumberRange.new(2, 3)
    api.Rate = 120
    api.Speed = NumberRange.new(8, 14)
    api.EmissionDirection = Enum.NormalId.Top
    api.Parent = jurangMaut
    
    -- Mengeliminasi pemain yang jatuh dari arena
    jurangMaut.Touched:Connect(function(hit)
        local h = hit.Parent:FindFirstChild("Humanoid")
        if h then h.Health = 0 end
    end)

    -- Pilar Cahaya Bergaya Sci-Fi
    for _, xPos in ipairs({-19, 19}) do
        local pilar = Instance.new("Part")
        pilar.Shape = Enum.PartType.Cylinder
        pilar.Size = Vector3.new(20, 3, 3) -- Orientation Cylinder di Roblox membentang di sumbu X
        pilar.CFrame = CFrame.new(panggungMulai.Position + Vector3.new(xPos, 10, 8)) * CFrame.Angles(0, 0, math.pi/2)
        pilar.Anchored = true
        pilar.Material = Enum.Material.SmoothPlastic
        pilar.BrickColor = BrickColor.new("Dark green")
        pilar.Parent = modelArena
        
        -- Cincin Emas melayang di pilar
        local cincin = Instance.new("Part")
        cincin.Shape = Enum.PartType.Cylinder
        cincin.Size = Vector3.new(2, 3.5, 3.5)
        cincin.CFrame = CFrame.new(panggungMulai.Position + Vector3.new(xPos, 15, 8)) * CFrame.Angles(0, 0, math.pi/2)
        cincin.Anchored = true
        cincin.Material = Enum.Material.SmoothPlastic
        cincin.BrickColor = BrickColor.new("Khaki")
        cincin.Parent = modelArena
    end

    -- Papan Soal Raksasa
    local papanSoal = Instance.new("Part")
    papanSoal.Name = "PapanSoal"
    papanSoal.Size = Vector3.new(34, 18, 2)
    papanSoal.Position = posisiAwal + Vector3.new(0, 26, 22) -- Diangkat tinggi ke Y=26 agar tidak terhalang pintu
    papanSoal.Anchored = true
    papanSoal.Material = Enum.Material.SmoothPlastic
    papanSoal.BrickColor = BrickColor.new("Dark green")
    papanSoal.Parent = modelArena
    
    local layarSoal = Instance.new("Part")
    layarSoal.Size = Vector3.new(32, 16, 2.2)
    layarSoal.Position = papanSoal.Position
    layarSoal.Anchored = true
    layarSoal.Material = Enum.Material.SmoothPlastic
    layarSoal.BrickColor = BrickColor.new("Really black")
    layarSoal.Parent = modelArena
    
    local guiSoal = Instance.new("SurfaceGui")
    guiSoal.Face = Enum.NormalId.Front
    guiSoal.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
    guiSoal.CanvasSize = Vector2.new(1600, 800)
    guiSoal.Parent = layarSoal
    
    local teksSoal = Instance.new("TextLabel")
    teksSoal.Name = "Text"
    teksSoal.Size = UDim2.new(0.9, 0, 0.9, 0)
    teksSoal.Position = UDim2.new(0.05, 0, 0.05, 0)
    teksSoal.BackgroundTransparency = 1
    teksSoal.TextScaled = true
    teksSoal.TextWrapped = true
    teksSoal.TextColor3 = Color3.fromRGB(255, 255, 255)
    teksSoal.Font = Enum.Font.GothamBold
    teksSoal.Text = "Menunggu Permainan Dimulai..."
    teksSoal.Parent = guiSoal
    
    local garisTepiSoal = Instance.new("UIStroke")
    garisTepiSoal.Color = Color3.fromRGB(160, 148, 96)
    garisTepiSoal.Thickness = 3
    garisTepiSoal.Parent = teksSoal
    
    -- 3 Pintu Tegak (Berdiri)
    local daftarPintu = {}
    for i = 1, 3 do
        local pintu = Instance.new("Part")
        pintu.Name = "Pintu_" .. i
        pintu.Size = Vector3.new(10, 14, 1) -- Lebar 10, Tinggi 14, Tebal 1
        pintu.Position = posisiAwal + Vector3.new((i-2)*13, 7, 10.5) -- Rapat dengan batas depan panggungMulai (Z=10)
        pintu.Anchored = true
        pintu.Material = Enum.Material.SmoothPlastic
        pintu.BrickColor = BrickColor.new("Black")
        pintu.Parent = modelArena
        
        local cahayaPintu = Instance.new("Part")
        cahayaPintu.Name = "Glow"
        cahayaPintu.Size = Vector3.new(10.5, 14.5, 0.5)
        cahayaPintu.Position = pintu.Position + Vector3.new(0, 0, 0.5) -- Dipindah ke belakang pintu agar tidak menutupi teks di depan (-Z)
        cahayaPintu.Anchored = true
        cahayaPintu.Material = Enum.Material.SmoothPlastic
        cahayaPintu.BrickColor = BrickColor.new("Dark stone grey")
        cahayaPintu.Parent = pintu
        
        local guiPintu = Instance.new("SurfaceGui")
        guiPintu.Face = Enum.NormalId.Front
        guiPintu.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
        guiPintu.CanvasSize = Vector2.new(500, 700)
        guiPintu.Parent = pintu
        
        local teksPintu = Instance.new("TextLabel")
        teksPintu.Name = "Text"
        teksPintu.Size = UDim2.new(0.9, 0, 0.9, 0)
        teksPintu.Position = UDim2.new(0.05, 0, 0.05, 0)
        teksPintu.BackgroundTransparency = 1
        teksPintu.TextScaled = true
        teksPintu.TextWrapped = true
        teksPintu.TextColor3 = Color3.fromRGB(255, 255, 255) -- Teks putih
        teksPintu.Font = Enum.Font.GothamBold
        teksPintu.Text = "Opsi " .. i
        teksPintu.Parent = guiPintu
        
        local garisTepiPintu = Instance.new("UIStroke")
        garisTepiPintu.Color = Color3.fromRGB(150, 140, 95)
        garisTepiPintu.Thickness = 2
        garisTepiPintu.Parent = teksPintu
        
        table.insert(daftarPintu, pintu)
    end
    
    return {
        model = modelArena,
        posisiMulai = panggungMulai.Position + Vector3.new(0, 5, 0),
        posisiPenonton = panggungPenonton.Position + Vector3.new(0, 5, 0),
        teksSoal = teksSoal,
        pintuPintu = daftarPintu,
        panggungMulai = panggungMulai,
        cahayaMulai = cahayaMulai
    }
end

return PembuatArena
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">PembuatMasjid</string>
          <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")

local PembuatMasjid = {}

-- ==========================================
-- PROCEDURAL MOSQUE LOBBY (Membuat Masjid)
-- ==========================================
function PembuatMasjid.bangunMasjidLobby()
    local lobbyLama = Workspace:FindFirstChild("LobbyMosque")
    if lobbyLama then
        lobbyLama:Destroy()
    end

    local modelLobby = Instance.new("Model")
    modelLobby.Name = "LobbyMosque"
    modelLobby.Parent = Workspace
    
    -- Hapus Baseplate Bawaan
    local baseplateLama = Workspace:FindFirstChild("Baseplate")
    if baseplateLama then baseplateLama:Destroy() end

    -- Plaza Utama (Lobby Floor)
    local alunAlun = Instance.new("Part")
    alunAlun.Name = "Plaza"
    alunAlun.Size = Vector3.new(200, 2, 200)
    alunAlun.Position = Vector3.new(0, -1, 0)
    alunAlun.Anchored = true
    alunAlun.Material = Enum.Material.Marble
    alunAlun.Color = Color3.fromRGB(122, 122, 114)
    alunAlun.Parent = modelLobby
    
    -- SpawnLocation
    local lokasiLahir = Instance.new("SpawnLocation")
    lokasiLahir.Size = Vector3.new(10, 1, 10)
    lokasiLahir.Position = Vector3.new(0, 0.5, -40)
    lokasiLahir.Anchored = true
    lokasiLahir.Material = Enum.Material.SmoothPlastic
    lokasiLahir.Color = Color3.fromRGB(96, 118, 100)
    lokasiLahir.Parent = modelLobby

    -- Bangunan Utama Masjid
    local bangunanUtama = Instance.new("Part")
    bangunanUtama.Name = "MainBuilding"
    bangunanUtama.Size = Vector3.new(60, 30, 40)
    bangunanUtama.Position = Vector3.new(0, 15, 0)
    bangunanUtama.Anchored = true
    bangunanUtama.Material = Enum.Material.SmoothPlastic
    bangunanUtama.Color = Color3.fromRGB(164, 164, 152)
    bangunanUtama.Parent = modelLobby
    
    -- Kubah Utama (Dome)
    local kubah = Instance.new("Part")
    kubah.Name = "Dome"
    kubah.Shape = Enum.PartType.Ball
    kubah.Size = Vector3.new(35, 35, 35)
    kubah.Position = Vector3.new(0, 30 + 17.5 - 5, 0) -- ditenggelamkan sedikit
    kubah.Anchored = true
    kubah.Material = Enum.Material.SmoothPlastic
    kubah.BrickColor = BrickColor.new("Khaki")
    kubah.Parent = modelLobby
    
    -- Pintu Masuk Raksasa (Arch)
    local gerbang = Instance.new("Part")
    gerbang.Size = Vector3.new(15, 20, 2)
    gerbang.Position = Vector3.new(0, 10, -20)
    gerbang.Anchored = true
    gerbang.Material = Enum.Material.SmoothPlastic
    gerbang.BrickColor = BrickColor.new("Dark green")
    gerbang.Parent = modelLobby
    
    local lubangGerbang = Instance.new("Part")
    lubangGerbang.Size = Vector3.new(13, 19, 2.2)
    lubangGerbang.Position = Vector3.new(0, 9.5, -20)
    lubangGerbang.Anchored = true
    lubangGerbang.Material = Enum.Material.SmoothPlastic
    lubangGerbang.BrickColor = BrickColor.new("Black")
    lubangGerbang.Parent = modelLobby

    -- Menara (Minarets)
    for _, xPos in ipairs({-35, 35}) do
        local menara = Instance.new("Part")
        menara.Shape = Enum.PartType.Cylinder
        menara.Size = Vector3.new(60, 8, 8) -- X=height di Roblox Cylinder
        menara.CFrame = CFrame.new(Vector3.new(xPos, 30, -15)) * CFrame.Angles(0, 0, math.pi/2)
        menara.Anchored = true
        menara.Material = Enum.Material.SmoothPlastic
        menara.Color = Color3.fromRGB(150, 150, 140)
        menara.Parent = modelLobby
        
        -- Kubah Kecil Menara
        local kubahKecil = Instance.new("Part")
        kubahKecil.Shape = Enum.PartType.Ball
        kubahKecil.Size = Vector3.new(10, 10, 10)
        kubahKecil.Position = Vector3.new(xPos, 60 + 5 - 2, -15)
        kubahKecil.Anchored = true
        kubahKecil.Material = Enum.Material.SmoothPlastic
        kubahKecil.BrickColor = BrickColor.new("Khaki")
        kubahKecil.Parent = modelLobby
    end
    
    -- Cahaya Masjid
    local cahayaLobby = Instance.new("PointLight")
    cahayaLobby.Range = 100
    cahayaLobby.Brightness = 1
    cahayaLobby.Color = Color3.fromRGB(187, 166, 126)
    cahayaLobby.Parent = bangunanUtama
end

return PembuatMasjid
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="21">
        <Properties>
          <string name="Name">ServerPermainan</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DataSurah = require(Shared:WaitForChild("SurahData"))

local PembuatMasjid = require(script.Parent:WaitForChild("PembuatMasjid"))
local PembuatArena = require(script.Parent:WaitForChild("PembuatArena"))

-- ==========================================
-- CINEMATIC LIGHTING
-- ==========================================
local efekCahaya = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
efekCahaya.Intensity = 0.28
efekCahaya.Size = 14
efekCahaya.Threshold = 1
efekCahaya.Parent = Lighting

local koreksiWarna = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
koreksiWarna.Contrast = 0.08
koreksiWarna.Saturation = -0.05
koreksiWarna.TintColor = Color3.fromRGB(232, 236, 224)
koreksiWarna.Parent = Lighting

Lighting.Brightness = 1.35
Lighting.Ambient = Color3.fromRGB(42, 48, 40)
Lighting.OutdoorAmbient = Color3.fromRGB(28, 34, 30)

local Acara = ReplicatedStorage:WaitForChild("Events")
local AcaraBuatRuangan = Acara:WaitForChild("BuatRuangan")
local AcaraMasukRuangan = Acara:WaitForChild("MasukRuangan")
local AcaraKeluarRuangan = Acara:WaitForChild("KeluarRuangan")
local AcaraMulaiPermainan = Acara:WaitForChild("MulaiPermainan")
local AcaraMainLagi = Acara:WaitForChild("MainLagi")
local AcaraPerbaruiRuangan = Acara:WaitForChild("PerbaruiRuangan")
local AcaraStatusRuanganBerubah = Acara:WaitForChild("StatusRuanganBerubah")

-- Game State
local DaftarRuangan = {}
local RuanganPemain = {}
local PenghitungRuangan = 0

local MAKSIMAL_NYAWA = 3
local MAKSIMAL_PEMAIN = 4

-- ==========================================
-- LOGIKA PEMBANTU (MENGELOLA PEMAIN, GILIRAN, DLL)
-- ==========================================
local function siarkanDaftarRuangan()
    local daftar = {}
    for id, ruangan in pairs(DaftarRuangan) do
        if ruangan.status == "Menunggu" then
            table.insert(daftar, {
                id = id,
                namaHost = ruangan.host.Name,
                jumlahPemain = #ruangan.pemainPemain,
                maksimalPemain = ruangan.maksimalPemain
            })
        end
    end
    AcaraPerbaruiRuangan:FireAllClients(daftar)
end

local function siarkanStatusRuangan(ruangan)
    local dataStatus = {
        status = ruangan.status,
        pemainPemain = {},
        indeksGiliran = ruangan.indeksGiliran,
        pemenang = ruangan.pemenang
    }

    if ruangan.indeksSurah and DataSurah[ruangan.indeksSurah] then
        dataStatus.namaSurahSaatIni = DataSurah[ruangan.indeksSurah].name
        dataStatus.ayatSaatIni = DataSurah[ruangan.indeksSurah].ayat[ruangan.indeksAyat]
    end

    for _, p in ipairs(ruangan.pemainPemain) do
        table.insert(dataStatus.pemainPemain, {
            nama = p.Name,
            skor = ruangan.skorPemain[p] or 0,
            nyawa = ruangan.nyawaPemain[p] or 0,
            apakahHost = (p == ruangan.host),
            apakahGiliran = (ruangan.pemainPemain[ruangan.indeksGiliran] == p)
        })
    end

    for _, p in ipairs(ruangan.pemainPemain) do
        AcaraStatusRuanganBerubah:FireClient(p, dataStatus)
    end
end

local function pindahkanPemain(pemain, posisi)
    local karakter = pemain.Character
    if karakter and karakter:FindFirstChild("HumanoidRootPart") then
        karakter.HumanoidRootPart.CFrame = CFrame.new(posisi)
    end
end

local function dapatkanGiliranSelanjutnya(ruangan)
    local indeksAwal = ruangan.indeksGiliran
    local indeksLanjut = indeksAwal
    repeat
        indeksLanjut = (indeksLanjut % #ruangan.pemainPemain) + 1
        if ruangan.nyawaPemain[ruangan.pemainPemain[indeksLanjut]] > 0 then
            return indeksLanjut
        end
    until indeksLanjut == indeksAwal
    return nil
end

local TARGET_SKOR = 100 -- Butuh 10 soal (100 poin) untuk menang

local function cekPermainanSelesai(ruangan)
    local jumlahHidup = 0
    local pemenang = nil

    for _, p in ipairs(ruangan.pemainPemain) do
        if ruangan.nyawaPemain[p] > 0 then
            jumlahHidup = jumlahHidup + 1
        end
        if (ruangan.skorPemain[p] or 0) >= TARGET_SKOR then
            pemenang = p
        end
    end

    local apakahBanyakPemain = #ruangan.pemainPemain > 1
    local apakahSelesai = false
    
    if pemenang then
        apakahSelesai = true -- Seseorang mencapai target
    elseif jumlahHidup == 0 then
        apakahSelesai = true -- Semua orang mati (termasuk main solo)
    elseif apakahBanyakPemain and jumlahHidup == 1 then
        apakahSelesai = true -- Di multiplayer, orang terakhir yang hidup menang
    end

    if apakahSelesai then
        ruangan.status = "Selesai"
        
        -- Tentukan pemenang
        if not pemenang and jumlahHidup == 1 and apakahBanyakPemain then
            for _, p in ipairs(ruangan.pemainPemain) do
                if ruangan.nyawaPemain[p] > 0 then pemenang = p end
            end
        end
        
        ruangan.pemenang = pemenang and pemenang.Name or "Tidak ada"
        if ruangan.pemenang == "Tidak ada" then
            ruangan.arena.teksSoal.Text = "PERMAINAN BERAKHIR! Semua pemain gugur."
        else
            ruangan.arena.teksSoal.Text = "SELAMAT! Pemenang: " .. ruangan.pemenang
        end
        
        -- Teleport semua kembali ke LOBBY MASJID
        for _, p in ipairs(ruangan.pemainPemain) do
            pindahkanPemain(p, Vector3.new(0, 5, -40))
        end
        
        return true
    end
    return false
end

-- ==========================================
-- LOGIKA PENGAMBILAN SOAL & PENGECEKAN JAWABAN (PINTU)
-- ==========================================
local function perbaruiSoalArena(ruangan)
    -- Pastikan lantai tertutup kembali setelah ada yang jatuh
    ruangan.arena.panggungMulai.CanCollide = true
    ruangan.arena.panggungMulai.Transparency = 0
    ruangan.arena.cahayaMulai.CanCollide = true
    ruangan.arena.cahayaMulai.Transparency = 0
    
    -- Pastikan pintu tertutup kembali dan warnanya di-reset
    for _, pintu in ipairs(ruangan.arena.pintuPintu) do
        pintu.CanCollide = true
        pintu.Transparency = 0
        pintu.BrickColor = BrickColor.new("Black")
    end
    
    if ruangan.status ~= "Bermain" then return end
    
    local surahSaatIni = DataSurah[ruangan.indeksSurah]
    local ayatSaatIni = surahSaatIni.ayat[ruangan.indeksAyat]
    local jawabanBenar = surahSaatIni.ayat[ruangan.indeksAyat + 1]
    
    if not jawabanBenar then
        -- Surah habis, ganti ke surah acak baru!
        ruangan.indeksSurah = math.random(1, #DataSurah)
        ruangan.indeksAyat = 1
        surahSaatIni = DataSurah[ruangan.indeksSurah]
        ayatSaatIni = surahSaatIni.ayat[ruangan.indeksAyat]
        jawabanBenar = surahSaatIni.ayat[ruangan.indeksAyat + 1]
    end
    
    -- Setup Question Text
    local pemainAktif = ruangan.pemainPemain[ruangan.indeksGiliran]
    ruangan.arena.teksSoal.Text = "[".. pemainAktif.Name .. "]\n" .. ayatSaatIni
    
    -- Generate Wrong Options
    local pilihanJawaban = {jawabanBenar}
    local semuaAyat = {}
    for _, s in ipairs(DataSurah) do
        for _, a in ipairs(s.ayat) do
            if a ~= jawabanBenar then table.insert(semuaAyat, a) end
        end
    end
    
    while #pilihanJawaban < 3 do
        local kandidat = semuaAyat[math.random(1, #semuaAyat)]
        local sudahAda = false
        for _, opt in ipairs(pilihanJawaban) do
            if opt == kandidat then
                sudahAda = true
                break
            end
        end
        if not sudahAda then
            table.insert(pilihanJawaban, kandidat)
        end
    end
    
    -- Shuffle Options
    for i = #pilihanJawaban, 2, -1 do
        local j = math.random(i)
        pilihanJawaban[i], pilihanJawaban[j] = pilihanJawaban[j], pilihanJawaban[i]
    end
    
    ruangan.indeksPintuBenar = 0
    
    -- Assign to doors and bind Touch event
    for i, pintu in ipairs(ruangan.arena.pintuPintu) do
        pintu.SurfaceGui.Text.Text = pilihanJawaban[i]
        
        -- Disconnect old touches
        if ruangan.koneksiPintu[i] then ruangan.koneksiPintu[i]:Disconnect() end
        
        local cahayaPintu = pintu:FindFirstChild("Glow")
        if cahayaPintu then cahayaPintu.BrickColor = BrickColor.new("Dark stone grey") end
        
        if pilihanJawaban[i] == jawabanBenar then
            ruangan.indeksPintuBenar = i
        end
        
        ruangan.koneksiPintu[i] = pintu.Touched:Connect(function(hit)
            local karakter = hit.Parent
            local pemainMenyentuh = Players:GetPlayerFromCharacter(karakter)
            
            if pemainMenyentuh == pemainAktif and ruangan.status == "Bermain" and ruangan.sedangMemprosesGiliran == false then
                ruangan.sedangMemprosesGiliran = true
                
                if i == ruangan.indeksPintuBenar then
                    -- Benar!
                    if ruangan.koneksiPintu[i] then ruangan.koneksiPintu[i]:Disconnect() end
                    if not ruangan.skorPemain[pemainMenyentuh] then ruangan.skorPemain[pemainMenyentuh] = 0 end
                    ruangan.skorPemain[pemainMenyentuh] = ruangan.skorPemain[pemainMenyentuh] + 10
                    
                    pintu.BrickColor = BrickColor.new("Forest green")
                    pintu.CanCollide = false -- Nembus!
                    pintu.Transparency = 0.5
                    if cahayaPintu then cahayaPintu.BrickColor = BrickColor.new("Sea green") end
                    
                    -- Biarkan pemain berlari menembus pintu ke platform aman
                    task.wait(1.5)
                    
                    ruangan.indeksAyat = ruangan.indeksAyat + 1
                    
                    local apakahSelesai = cekPermainanSelesai(ruangan)
                    if not apakahSelesai then
                        pindahkanPemain(pemainMenyentuh, ruangan.arena.posisiPenonton)
                        ruangan.indeksGiliran = dapatkanGiliranSelanjutnya(ruangan)
                        if ruangan.indeksGiliran then
                            local pemainSelanjutnya = ruangan.pemainPemain[ruangan.indeksGiliran]
                            perbaruiSoalArena(ruangan)
                            pindahkanPemain(pemainSelanjutnya, ruangan.arena.posisiMulai)
                        end
                    end
                else
                    -- Salah!
                    ruangan.nyawaPemain[pemainMenyentuh] = ruangan.nyawaPemain[pemainMenyentuh] - 1
                    local hum = karakter:FindFirstChild("Humanoid")
                    if hum then hum.Health = 0 end
                    
                    if ruangan.nyawaPemain[pemainMenyentuh] <= 0 then
                        if not cekPermainanSelesai(ruangan) then
                            ruangan.indeksGiliran = dapatkanGiliranSelanjutnya(ruangan)
                            -- Note: Respawn handler will teleport pemainSelanjutnya
                        end
                    end
                end
                
                siarkanStatusRuangan(ruangan)
                task.wait(2)
                if cahayaPintu then cahayaPintu.BrickColor = BrickColor.new("Dark stone grey") end
                ruangan.sedangMemprosesGiliran = false
            end
        end)
    end
end

-- ==========================================
-- EVENT HANDLERS
-- ==========================================
PembuatMasjid.bangunMasjidLobby()

-- ==========================================
-- EVENTS
-- ==========================================
AcaraBuatRuangan.OnServerInvoke = function(pemain)
    if RuanganPemain[pemain] then return false, "Anda sudah berada di dalam ruangan." end
    
    PenghitungRuangan = PenghitungRuangan + 1
    local idRuangan = tostring(PenghitungRuangan)
    
    local arena = PembuatArena.buatArena(PenghitungRuangan)
    
    local ruanganBaru = {
        id = idRuangan,
        host = pemain,
        pemainPemain = {pemain},
        status = "Menunggu",
        maksimalPemain = MAKSIMAL_PEMAIN,
        indeksSurah = math.random(1, #DataSurah),
        indeksAyat = 1,
        indeksGiliran = 1,
        skorPemain = {[pemain] = 0},
        nyawaPemain = {[pemain] = MAKSIMAL_NYAWA},
        arena = arena,
        koneksiPintu = {},
        sedangMemprosesGiliran = false
    }
    
    DaftarRuangan[idRuangan] = ruanganBaru
    RuanganPemain[pemain] = idRuangan
    
    pindahkanPemain(pemain, arena.posisiPenonton)
    siarkanDaftarRuangan()
    siarkanStatusRuangan(ruanganBaru)
    return true, idRuangan
end

AcaraMasukRuangan.OnServerInvoke = function(pemain, idRuangan)
    if RuanganPemain[pemain] then return false, "Sudah ada di dalam ruangan." end
    local ruangan = DaftarRuangan[idRuangan]
    if not ruangan then return false, "Ruangan tidak ditemukan." end
    if ruangan.status ~= "Menunggu" then return false, "Permainan sudah dimulai." end
    if #ruangan.pemainPemain >= ruangan.maksimalPemain then return false, "Ruangan penuh." end
    
    table.insert(ruangan.pemainPemain, pemain)
    ruangan.skorPemain[pemain] = 0
    ruangan.nyawaPemain[pemain] = MAKSIMAL_NYAWA
    RuanganPemain[pemain] = idRuangan
    
    pindahkanPemain(pemain, ruangan.arena.posisiPenonton)
    siarkanDaftarRuangan()
    siarkanStatusRuangan(ruangan)
    return true
end

AcaraMulaiPermainan.OnServerEvent:Connect(function(pemain)
    local idRuangan = RuanganPemain[pemain]
    if not idRuangan then return end
    local ruangan = DaftarRuangan[idRuangan]
    if ruangan and ruangan.host == pemain and ruangan.status == "Menunggu" then
        ruangan.status = "Bermain"
        
        local pemainPertama = ruangan.pemainPemain[ruangan.indeksGiliran]
        pindahkanPemain(pemainPertama, ruangan.arena.posisiMulai)
        perbaruiSoalArena(ruangan)
        
        siarkanStatusRuangan(ruangan)
    end
end)

AcaraMainLagi.OnServerEvent:Connect(function(pemain)
    local idRuangan = RuanganPemain[pemain]
    if not idRuangan then return end
    local ruangan = DaftarRuangan[idRuangan]
    if ruangan and ruangan.host == pemain and ruangan.status == "Selesai" then
        ruangan.status = "Menunggu"
        ruangan.indeksSurah = math.random(1, #DataSurah)
        ruangan.indeksAyat = 1
        ruangan.indeksGiliran = 1
        ruangan.arena.teksSoal.Text = "Menunggu Permainan Dimulai..."
        
        for _, p in ipairs(ruangan.pemainPemain) do
            ruangan.skorPemain[p] = 0
            ruangan.nyawaPemain[p] = MAKSIMAL_NYAWA
            pindahkanPemain(p, ruangan.arena.posisiPenonton)
        end
        
        siarkanDaftarRuangan()
        siarkanStatusRuangan(ruangan)
    end
end)

AcaraKeluarRuangan.OnServerEvent:Connect(function(pemain)
    local idRuangan = RuanganPemain[pemain]
    if not idRuangan then return end
    
    local ruangan = DaftarRuangan[idRuangan]
    if ruangan then
        if ruangan.host == pemain then
            for _, p in ipairs(ruangan.pemainPemain) do
                RuanganPemain[p] = nil
                AcaraStatusRuanganBerubah:FireClient(p, {status = "Tutup"})
            end
            ruangan.arena.model:Destroy()
            DaftarRuangan[idRuangan] = nil
        else
            local pemainBaru = {}
            for _, p in ipairs(ruangan.pemainPemain) do
                if p ~= pemain then table.insert(pemainBaru, p) end
            end
            ruangan.pemainPemain = pemainBaru
            RuanganPemain[pemain] = nil
            AcaraStatusRuanganBerubah:FireClient(pemain, {status = "Tutup"})
            
            if ruangan.status == "Bermain" then cekPermainanSelesai(ruangan) end
            if DaftarRuangan[idRuangan] then siarkanStatusRuangan(ruangan) end
        end
    end
    siarkanDaftarRuangan()
end)

Players.PlayerRemoving:Connect(function(pemain)
    local idRuangan = RuanganPemain[pemain]
    if not idRuangan then
        return
    end

    local ruangan = DaftarRuangan[idRuangan]
    if not ruangan then
        RuanganPemain[pemain] = nil
        return
    end

    if ruangan.host == pemain then
        for _, p in ipairs(ruangan.pemainPemain) do
            RuanganPemain[p] = nil
            AcaraStatusRuanganBerubah:FireClient(p, {status = "Tutup"})
        end

        if ruangan.arena and ruangan.arena.model then
            ruangan.arena.model:Destroy()
        end
        DaftarRuangan[idRuangan] = nil
    else
        local pemainBaru = {}
        for _, p in ipairs(ruangan.pemainPemain) do
            if p ~= pemain then
                table.insert(pemainBaru, p)
            end
        end
        ruangan.pemainPemain = pemainBaru
        ruangan.skorPemain[pemain] = nil
        ruangan.nyawaPemain[pemain] = nil
        RuanganPemain[pemain] = nil

        if ruangan.status == "Bermain" then
            cekPermainanSelesai(ruangan)
        end

        if DaftarRuangan[idRuangan] then
            siarkanStatusRuangan(ruangan)
        end
    end

    siarkanDaftarRuangan()
end)

-- Handle Respawn to teleport back to correct area
Players.PlayerAdded:Connect(function(pemain)
    pemain.CharacterAdded:Connect(function(karakter)
        task.wait(0.5) -- tunggu fisik stabil
        local idRuangan = RuanganPemain[pemain]
        if idRuangan then
            local ruangan = DaftarRuangan[idRuangan]
            if ruangan then
                if ruangan.status == "Bermain" then
                    if ruangan.pemainPemain[ruangan.indeksGiliran] == pemain and ruangan.nyawaPemain[pemain] > 0 then
                        pindahkanPemain(pemain, ruangan.arena.posisiMulai)
                    else
                        pindahkanPemain(pemain, ruangan.arena.posisiPenonton)
                        -- Jika pemain mati dan kehabisan nyawa, giliran berpindah. Pindahkan pemain aktif ke tempat mulai.
                        local pemainAktifSekarang = ruangan.pemainPemain[ruangan.indeksGiliran]
                        if pemainAktifSekarang and ruangan.nyawaPemain[pemainAktifSekarang] > 0 then
                            pindahkanPemain(pemainAktifSekarang, ruangan.arena.posisiMulai)
                            perbaruiSoalArena(ruangan)
                        end
                    end
                else
                    pindahkanPemain(pemain, ruangan.arena.posisiPenonton)
                end
            end
        end
    end)
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="22">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
