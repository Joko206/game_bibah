{
  "name": "game bibah",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Events": {
        "$className": "Folder",
        "BuatRuangan": { "$className": "RemoteFunction" },
        "MasukRuangan": { "$className": "RemoteFunction" },
        "KirimJawaban": { "$className": "RemoteFunction" },
        "MulaiPermainan": { "$className": "RemoteEvent" },
        "MainLagi": { "$className": "RemoteEvent" },
        "KeluarRuangan": { "$className": "RemoteEvent" },
        "PerbaruiRuangan": { "$className": "RemoteEvent" },
        "StatusRuanganBerubah": { "$className": "RemoteEvent" },
        "AcaraUmpanBalik": { "$className": "RemoteEvent" }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "StarterGui": {
      "ScreenGui": {
        "$className": "ScreenGui",
        "$properties": {
          "ResetOnSpawn": false
        },
        "KlienUtama": {
          "$path": "src/startergui/KlienUtama.client.lua"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [0.38823, 0.37254, 0.38823],
          "Locked": true,
          "Position": [0, -10, 0],
          "Size": [512, 20, 512]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0, 0, 0],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}